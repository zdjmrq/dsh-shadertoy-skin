// The floor tile under a picture pixel below the horizon, across and away; the floor runs toward us a tile a beat.
ivec2 floorTile(vec2 f, float beats) {
    float d = HORIZON - f.y;
    return ivec2(floor(vec2((f.x - 0.5 * float(RICK_W)) / d, 21.0 / d + beats)));
}
// A palm tree's silhouette standing on the horizon: a leaning trunk and six drooping fronds that bob a pixel on the beat.
bool palm(vec2 f, float x0, float lean, float beats) {
    vec2 top = vec2(x0 + 6.0 * lean, HORIZON + 27.0);
    if (abs(f.x - top.x) > 12.0 || f.y < HORIZON - 3.0 || f.y > top.y + 3.5) return false;
    float u = (f.y - HORIZON + 3.0) / 30.0;
    if (u <= 1.0 && abs(f.x - x0 - 6.0 * lean * u * u) < 1.5 - 0.6 * u) return true;
    float bob = float(int(beats) & 1);
    for (int i = 0; i < 6; i++) {
        float dx = (f.x - top.x) * (i < 3 ? -1.0 : 1.0);
        float k = i % 3 == 0 ? 0.7 : (i % 3 == 1 ? 0.15 : -0.45);
        if (dx >= 0.0 && dx <= 11.0 && abs(f.y - top.y - k * dx + 0.05 * dx * dx + bob * dx / 11.0) < 0.9) return true;
    }
    return false;
}
