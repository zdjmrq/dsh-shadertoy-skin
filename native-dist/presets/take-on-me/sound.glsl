// Backing: events -> phrases -> voices; bank 0 is the backing track, bank 1 is the choir, whose two components share one track.
void vBacking(int samp,float time){
    for(int i=soundLoopBase;i<16;i++){
        if(i>=BEVN)break;uint event=uint(wsel(BEVENTS[i>>2],i&3));int id=int((event>>22)&3u);
        uint phrase=uint(wsel(BPHRASE[id>>2],id&3));int first=int(phrase&7u),voices=int((phrase>>3)&7u);
        float start=scoreTime(float(event&16383u));int startSample=int(round(start*iSampleRate));float age=float(samp-startSample)/iSampleRate;
        if(age<0.||age>=float(phrase>>6)*.005)continue;
        for(int k=soundLoopBase;k<6;k++){
            if(k>=voices)break;int voice=first+k;
            if(voice==0&&age>=float(BCUT)*.005)continue;
            float level=voice==0?BLVL0:voice==1?BLVL1:BLVL2;
            uint desc=uint(wsel(BVOICE[voice>>2],voice&3));
            VJob j=vBlank();
            for(int c=soundLoopBase;c<3;c++){int cid=int((desc>>uint(c*8))&255u);int cw=cid*2;int o=wsel(BCURVE[cw>>2],cw&3),n=wsel(BCURVE[(cw+1)>>2],(cw+1)&3);if(c==0){j.start0=o;j.count0=n;}else if(c==1){j.start1=o;j.count1=n;}else{j.start2=o;j.count2=n;}}
            j.now=age;j.seconds=floor(age);j.fraction=fract(age);j.book=2;j.seed=(desc>>24)*3533u*97u;j.choir=voice>=2;
            j.dest=id==0?2:3;j.w0=float((event>>14)&255u);j.w1=level;j.w2=id!=0&&k==1?MIX_CHOIR_UPPER:1.;vPush(j);
        }
    }
}
void vocalTracks(int samp,float time,out vec2 lead,out vec2 backing,out vec2 choir){
    vjobN=0;float wet,mute;
    vLead(samp,time,wet,mute);
    vBacking(samp,time);
    vec2 base=vec2(0.);float added=0.;backing=vec2(0.);choir=vec2(0.);
    for(int q=soundLoopBase;q<NVJ;q++){
        if(q>=vjobN)break;
        uvec4 a,b,c,d;for(int k=soundLoopBase;k<4;k++){uvec4 v=vjobs[q*4+k];if(k==0)a=v;else if(k==1)b=v;else if(k==2)c=v;else d=v;}
        VJob j;j.start0=int(a.x&65535u);j.count0=int(a.x>>16);j.start1=int(a.y&65535u);j.count1=int(a.y>>16);j.start2=int(a.z&65535u);j.count2=int(a.z>>16);
        j.tick0=int(a.w&65535u);j.tick1=int(a.w>>16);j.tick2=int(b.x&65535u);uint flags=b.x>>16;
        j.absolute=(flags&1u)!=0u;j.choir=(flags&2u)!=0u;j.gate=(flags&4u)!=0u;j.book=int((flags>>3)&3u);j.dest=int((flags>>5)&7u);
        j.sampleIndex=int(b.y);j.seed=b.z;j.phase2=uintBitsToFloat(b.w);
        j.now=uintBitsToFloat(c.x);j.vfrac=uintBitsToFloat(c.y);j.seconds=uintBitsToFloat(c.z);j.fraction=uintBitsToFloat(c.w);
        j.width=uintBitsToFloat(d.x);j.w0=uintBitsToFloat(d.y);j.w1=uintBitsToFloat(d.z);j.w2=uintBitsToFloat(d.w);
        uvec2 es,gs;float eu,gu;vec2 fp;
        for(int c=soundLoopBase;c<3;c++){
            int st=c==0?j.start0:c==1?j.start1:j.start2,cn=c==0?j.count0:c==1?j.count1:j.count2,tk=c==0?j.tick0:c==1?j.tick1:j.tick2;
            uvec2 pr;float uu;vec2 f2;
            vScan(c,st,cn,tk,c==1?j.phase2:0.,j.now,j.absolute,j.sampleIndex,j.vfrac,pr,uu,f2);
            if(c==0){es=pr;eu=uu;}else if(c==1){fp=f2;}else{gs=pr;gu=uu;}
        }
        vec2 v=vSynth(es,gs,eu,gu,fp,j.seconds,j.fraction,j.book,j.seed,j.width,j.choir,j.gate,j.absolute);
        if(j.dest==0)base=v*1.002722349*.292556080;
        else if(j.dest==1)added+=v.x*j.w0/128.*j.w1*j.w2;
        else{vec2 t=v*j.w0/128.*j.w1;if(j.dest==2)backing+=t;else choir+=t*j.w2;}
    }
    vec2 v=(base*(1.-wet)+vec2(added))*(1.-mute);
    v=v*2.408;
    lead=tanh(v*1.3)/1.3;
}
vec2 gSum=vec2(0.),gBus=vec2(0.);int gGroup=0;
vec2 busSound(int g,vec2 y){if(g==3)return tanh(y*1.4);return y;}
// Bus groups are summed in track order; a group change flushes the previous bus through its saturator.
void addTrack(int tr,vec2 y){
    int g=TK_GROUP[tr];float gain=MIX_GAIN[tr];
    if(g!=gGroup){gSum+=busSound(gGroup,gBus);gBus=vec2(0.);gGroup=g;}
    if(gain==0.)return;
    gBus+=y*gain;
}
float noteAge(int s,SNote n){return float(s-int(round(n.start*iSampleRate)))/iSampleRate;}
vec2 mainSound(int samp,float time){
    soundLoopBase=min(int(iDate.w),0);
    time=float(samp)/iSampleRate;
    if(time<0.||time>=180.)return vec2(0.);
#ifdef VOCALS
    vec2 voxLead,voxBacking,voxChoir;vocalTracks(samp,time,voxLead,voxBacking,voxChoir);
#else
    vec2 voxLead=vec2(0.),voxBacking=vec2(0.),voxChoir=vec2(0.);
#endif
    gather(samp,time);
    for(int sl=soundLoopBase;sl<4;sl++){int tr=SL_TRACK[sl];vec2 y=vec2(0.);
        for(int n=actN[sl];n<actN[sl+1];n++){SNote nt=actNote(TK_GAIN[tr],act[n]);y+=vec2(F1_drumVoice(tr,noteAge(samp,nt))*nt.velocity*1.0655);}
        addTrack(tr,y);}
    {vec2 y=vec2(0.);for(int n=actN[4];n<actN[5];n++){SNote nt=actNote(TK_GAIN[4],act[n]);y+=vec2(F5_bassVoice(noteAge(samp,nt),nt.gate,nt.midi,nt.velocity));}addTrack(4,y);}
    {vec2 y=vec2(0.);for(int n=actN[5];n<actN[6];n++){SNote nt=actNote(TK_GAIN[5],act[n]);y+=vec2(F6_k6Bell(noteAge(samp,nt),nt.gate,nt.midi,nt.velocity,nt.aux,nt.start));}addTrack(5,y);}
    {vec2 y=vec2(0.);for(int i=soundLoopBase;i<2;i++){vec4 c=F6_K6_CLIP(i);vec2 p=F6_k6Fx(time-c.x,i);y+=vec2(p.x+p.y);}addTrack(6,y);}
    // three chorus taps per juno track; each tap has its own delayed sample clock from the gather
    for(int t2=soundLoopBase;t2<2;t2++){int tr=7+t2;vec2 y=vec2(0.);
        for(int tap=soundLoopBase;tap<3;tap++){int k=t2*3+tap;vec2 v=vec2(0.);
            for(int n=actN[6+k];n<actN[6+1+k];n++){SNote nt=actNote(TK_GAIN[tr],act[n]);float age=noteAge(slotSamp[6+k],nt);
                float seed=hash1(float(nt.tick)*.371+(tr==7?nt.midi-float(nt.aux)*6.:nt.midi+12.)*.129);
                v+=vec2(F7_junoLayer(age,nt.gate,nt.midi,tap==0?0.:1.,seed,nt.aux)*0.0515);}
            y+=tap==0?v*.44:tap==1?vec2(v.x*.56,0.):vec2(0.,v.x*.56);}
        addTrack(tr,y);}
    for(int sl=12+soundLoopBase;sl<17;sl++){int tr=SL_TRACK[sl];vec2 y=vec2(0.);
        for(int n=actN[sl];n<actN[sl+1];n++){SNote nt=actNote(TK_GAIN[tr],act[n]);float age=noteAge(samp,nt);y+=vec2(F8_padVoice(age,nt.gate,nt.midi,nt.velocity,nt.aux,nt.start)*smoothstep(0.,.014,nt.life-age));}
        if(time>131.07&&time<136.54)y*=clamp((131.18-time)/.11,0.,1.);
        addTrack(tr,y);}
    {vec2 y=vec2(0.);for(int n=actN[17];n<actN[18];n++){SNote nt=actNote(TK_GAIN[14],act[n]);y+=vec2(F9_keysVoice(noteAge(samp,nt),nt.gate,nt.midi,nt.velocity));}addTrack(14,y);}
    {addTrack(15,voxLead);addTrack(16,voxBacking);addTrack(17,voxChoir);}
    {vec2 y=vec2(0.);for(int n=actN[18];n<actN[19];n++){SNote nt=actNote(TK_GAIN[18],act[n]);y+=vec2(H14_note(false,noteAge(samp,nt),nt.gate,nt.midi,nt.velocity,nt.aux));}y*=1.-smoothstep(132.94,133.,time);addTrack(18,y);}
    {vec2 y=vec2(0.);for(int n=actN[19];n<actN[20];n++){SNote nt=actNote(TK_GAIN[19],act[n]);y+=vec2(H14_note(true,noteAge(samp,nt),nt.gate,nt.midi,nt.velocity,0));}y*=1.-smoothstep(134.94,135.,time);addTrack(19,y);}
    return (gSum+busSound(gGroup,gBus))*MIX_MASTER;
}
