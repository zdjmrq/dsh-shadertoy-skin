{
  "name": "dsh-shadertoy-skin",
  "version": "0.4.4",
  "description": "Realtime ShaderToy background skin for DeepSeek Harness — a zero-runtime-dependency WebGL2 player, background library and glass UI integration.",
  "type": "module",
  "license": "MIT",
  "author": "zdjmrq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zdjmrq/dsh-shadertoy-skin.git"
  },
  "homepage": "https://github.com/zdjmrq/dsh-shadertoy-skin#readme",
  "bugs": {
    "url": "https://github.com/zdjmrq/dsh-shadertoy-skin/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "skin",
    "wallpaper",
    "shadertoy",
    "webgl2"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "native-dist/player.html",
    "native-dist/player-controller.js",
    "native-dist/player-runtime.js",
    "native-dist/render-worker.js",
    "native-dist/panel.html",
    "native-dist/defaults.json",
    "native-dist/project.js",
    "native-dist/textures.js",
    "native-dist/pipeline.js",
    "native-dist/presets/index.json",
    "native-dist/presets/aurora.glsl",
    "native-dist/presets/flow.glsl",
    "native-dist/presets/pulse.glsl",
    "native-dist/presets/pulse-sound.glsl",
    "native-dist/presets/seascape.glsl",
    "native-dist/presets/mario.glsl",
    "native-dist/presets/mario-sound.glsl",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "native-dist/presets/take-on-me/common.glsl",
    "native-dist/presets/take-on-me/a.glsl",
    "native-dist/presets/take-on-me/image.glsl",
    "native-dist/presets/take-on-me/sound.glsl",
    "native-dist/presets/never-gonna-give-you-up/common.glsl",
    "native-dist/presets/never-gonna-give-you-up/image.glsl",
    "native-dist/presets/never-gonna-give-you-up/sound.glsl",
    "native-dist/presets/rain-window/image.glsl",
    "native-dist/presets/rain-window-no-lightning/image.glsl",
    "native-dist/presets/racing/common.glsl",
    "native-dist/presets/racing/a.glsl",
    "native-dist/presets/racing/b.glsl",
    "native-dist/presets/racing/image.glsl",
    "native-dist/presets/racing/sound.glsl",
    "native-dist/presets/voxel-world/a.glsl",
    "native-dist/presets/voxel-world/b.glsl",
    "native-dist/presets/voxel-world/c.glsl",
    "native-dist/presets/voxel-world/d.glsl",
    "native-dist/presets/voxel-world/image.glsl",
    "native-dist/presets/tree-in-wind/common.glsl",
    "native-dist/presets/tree-in-wind/a.glsl",
    "native-dist/presets/tree-in-wind/b.glsl",
    "native-dist/presets/tree-in-wind/image.glsl"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "node tools/dev-server.mjs 8730",
    "check": "node tools/check-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node tools/check-bundle.mjs && npm run typecheck && node tools/host-route-test.mjs && node tools/project-format-test.mjs",
    "test:host": "node tools/host-route-test.mjs",
    "test:renderer": "node tools/renderer-smoke.mjs",
    "test:audio": "node tools/audio-smoke.mjs",
    "test:panel": "node tools/panel-regression.mjs",
    "test:audit": "node tools/audit-regression.mjs",
    "test:ui": "node tools/ui-regression.mjs",
    "test:surfaces": "node tools/panel-surfaces-regression.mjs",
    "test:transparency": "node tools/unified-transparency-regression.mjs",
    "preview": "node tools/browser-harness.mjs 8735",
    "pack:check": "npm pack --dry-run --json",
    "test:core": "node tools/core-regression.mjs",
    "test:project": "node tools/project-audit-regression.mjs",
    "test:multi": "node tools/multipass-regression.mjs",
    "test:worker": "node tools/worker-regression.mjs",
    "test:editor": "node tools/tabbed-editor-regression.mjs",
    "test:startup": "node tools/startup-regression.mjs",
    "test:playback": "node tools/playback-regression.mjs",
    "test:interaction": "node tools/interaction-regression.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "playwright": "^1.55.0",
    "typescript": "7.0.2"
  }
}
