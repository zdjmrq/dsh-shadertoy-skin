        j.start2=V_BG+(anchor.y&8191);j.count2=V_NBG-(anchor.y&8191);j.tick2=(anchor.y>>13)&65535;
        j.start1=V_BP+(anchor.z&8191);j.count1=V_NBP-(anchor.z&8191);j.tick1=(anchor.z>>13)&65535;
        j.phase2=float((uint(anchor.z)>>29)|(uint(anchor.w)<<3))/65536.;
