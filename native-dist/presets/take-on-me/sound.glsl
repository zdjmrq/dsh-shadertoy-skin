vec2 vSynth(uvec2 es,uvec2 gs,float eu,float gu,vec2 fp,float seconds,float fraction,int book,uint seed,float width,bool choir,bool gate,bool absolute){
    float gainCode=mix(float((gs.x>>8)&127u),float((gs.y>>8)&127u),gu);
