// Whether a line's character has ink at this column and row of its eight by eight cell.
bool subInk(int first, int len, int x, int y) {
    if (x < 0 || y < 0 || y > 7 || x >= 8 * len) return false;
    int c = x >> 3;
    uint g = (PACKED(SUB_TEXT, first + c / 5) >> uint((c % 5) * 6)) & 63u;
    uvec4 f = SUB_FONT[g >> 1];
    uint w = (g & 1u) == 0u ? (y < 4 ? f.x : f.y) : (y < 4 ? f.z : f.w);
    return ((w >> uint(31 - 8 * (y & 3) - (x & 7))) & 1u) == 1u;
