void vPush(VJob j){
    if(vjobN>=NVJ)return;
    uvec4 a=uvec4(uint(j.start0)|uint(j.count0)<<16,uint(j.start1)|uint(j.count1)<<16,uint(j.start2)|uint(j.count2)<<16,uint(j.tick0)|uint(j.tick1)<<16);
