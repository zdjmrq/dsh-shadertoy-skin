// TypeScript is used as a *type checker only*: the package ships plain .js and
// has no build step, so `tsc --noEmit` verifies the JSDoc types of the sources
// that are loaded as-is (by Node, the browser, or the npm package).
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["native-dist/project.js", "native-dist/pipeline.js", "native-dist/textures.js"]
}
