        float seconds=floor(sourceTime);j.seconds=seconds;j.fraction=(float(sourceSample-int(seconds)*int(iSampleRate))+vfrac)/iSampleRate;
        j.book=0;j.seed=0u;j.width=.13652;j.gate=false;j.dest=0;vPush(j);
