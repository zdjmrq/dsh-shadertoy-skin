        float ph=float(osc)*2.1+midi*.23;
        float H14_delay=pluck?0.00013*H14_spread*(sin(TAU*(4.3+float(osc)*.23)*age+ph)-sin(ph)):0.0003*sin(TAU*(4.4+float(osc)*.19)*age+float(osc)*2.1+midi*.23);
