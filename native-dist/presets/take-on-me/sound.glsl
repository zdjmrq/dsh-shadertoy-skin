uint fb(float x){return floatBitsToUint(x);}
// Control-curve scan, dt in the low 8 bits; absolute = integer ticks with sub-sample dt (lead base), else float time from age 0.
void vScan(int kind,int start,int count,int tick,float phase,float now,bool absolute,int sampleIndex,float vfrac,out uvec2 pair,out float u,out vec2 fp){
    pair=uvec2(0);u=0.;fp=vec2(60.,0.);
    uint a=0u,b=0u;float f0=0.,f1=0.,t=0.;bool found=false;
    for(int j=soundLoopBase;j<513;j++){
        if(!absolute&&j>=count)break;
        if(absolute&&j>=512)break;
        uint r=voxRec(kind,start+min(j,count-1));float fr=kind==1?vFreq(r):0.;
        if(j>0){
            int d=int(a&255u);float dt=float(d)*.005;
            bool stop=absolute?(float(tick+d)*.005>now||j>=count-1):(now<t+dt||j==count-1);
            if(stop){b=r;f1=fr;found=true;break;}
            if(kind==1)phase=fract(phase+(absolute?.5*(f0+fr)*float(d)*.005:.5*(f0+fr)*dt));
            tick+=d;t+=dt;
        }
        a=r;f0=fr;
    }
    if(absolute){
        float dt=(float(sampleIndex-(tick/200)*int(iSampleRate))+vfrac)/iSampleRate-float(tick%200)*.005;
        float h=max(float(a&255u)*.005,.00001);u=clamp(dt/h,0.,1.);pair=uvec2(a,b);
        if(kind==1)fp=vec2(mix(f0,f1,u),fract(phase+f0*dt+.5*(f1-f0)*dt*dt/h+vPhaseFix(now)));
    }else if(found){
        float dt=float(a&255u)*.005;u=clamp((now-t)/dt,0.,1.);pair=uvec2(a,b);
