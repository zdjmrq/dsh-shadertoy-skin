float vChoirGain(float frequency,float gainCode){float band=mix(BBODY,BAIR,smoothstep(1500.,6500.,frequency));float levelDb=gainCode*(78./127.)-78.;return band*mix(BTAIL,1.,smoothstep(-62.,-42.,levelDb));}
// One control job = one voice. dest: 0 lead base, 1 lead repair, 2 backing, 3 choir (both components, w2 = trim).
struct VJob{int start0,count0,start1,count1,start2,count2;int tick0,tick1,tick2;float phase2;float now;bool absolute;int sampleIndex;float vfrac;float seconds,fraction;int book;uint seed;float width;bool choir;bool gate;int dest;float w0,w1,w2;};
