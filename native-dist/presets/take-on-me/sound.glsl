VJob vBlank(){VJob j;j.start0=0;j.count0=0;j.start1=0;j.count1=0;j.start2=0;j.count2=0;j.tick0=0;j.tick1=0;j.tick2=0;j.phase2=0.;j.now=0.;j.absolute=false;j.sampleIndex=0;j.vfrac=0.;j.seconds=0.;j.fraction=0.;j.book=0;j.seed=0u;j.width=0.;j.choir=false;j.gate=true;j.dest=0;j.w0=1.;j.w1=1.;j.w2=1.;return j;}
VJob vRepairJob(int voice,float age,float w0,float w1,float w2){
    VJob j=vBlank();ivec4 d=VVOICES[voice];
    j.start0=V_RS+(d.x&65535);j.count0=d.x>>16;j.start1=V_RP+(d.y&65535);j.count1=d.y>>16;j.start2=V_RG+(d.z&65535);j.count2=d.z>>16;
