float vPhaseFix(float t){float v=0.;for(int i=soundLoopBase;i<6;i++){int k=i*2;if(t*200.>=float(wsel(VPHASEFIX[k>>2],k&3)))v=intBitsToFloat(wsel(VPHASEFIX[(k+1)>>2],(k+1)&3));}return v;}
