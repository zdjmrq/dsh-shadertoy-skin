// Lead vocal: time routing, base voice from anchored streams, repair voices in three regions.
void vLead(int samp,float time,out float wet,out float mute){
    wet=0.;mute=0.;
    float vfrac=0.;int sourceSample=samp;float sourceTime=time;
    for(int r=1+soundLoopBase;r<=3;r++){
