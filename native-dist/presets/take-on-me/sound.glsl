uint voxRec(int kind,int i){int b=kind==0?0:i*21;int w=kind==0?i:V_PACK+(b>>5);int s=b&31;uvec2 p=uvec2(0u);for(int k=soundLoopBase;k<2;k++){uint q=uint(voxWord(w+k));if(k==0)p.x=q;else p.y=q;}uint v=s==0?p.x:(p.x>>uint(s))|(p.y<<uint(32-s));return kind==0?v:v&0x1fffffu;}
int cbWord(int i){return wsel(VCB[i>>2],i&3);}
float vNoise(float seconds,float fraction,float rate,uint seed){float z=seconds*fract(rate)+fraction*rate;uint n=uint(seconds)*uint(rate)+uint(floor(z));float u=fract(z);u=u*u*(3.-2.*u);return mix(randU(n+seed),randU(n+seed+1u),u)*2.8431;}
float vAP(uint q){return q==0u?0.:q==1u?.12:q==2u?.5:1.;}
float vFreq(uint r){return 60.*exp2(float((r>>8)&4095u)*(4.1963972128035/4095.));}
// Codebooks: 0 = lead base (nibbles), 1 = lead repair (bytes), 2 = backing (nibbles).
float vShape(int book,uint code,int k){
    int stage=k/8,entry=int((code>>uint(stage*6))&63u),w=stage*64+entry;
    uint v=uint(cbWord(book==1?256+w*2+((k&7)>>2):book==0?w:768+stage*32+entry));
