        float lower=700.*(exp(.1+float(j)*.2309)-1.),upper=700.*(exp(.1+float(j+1)*.2309)-1.);
        float center=round(.5*(lower+upper)*32.)/32.,bw=round((upper-lower)*32.)/32.,rate=round(bw*1.4*32.)/32.;
